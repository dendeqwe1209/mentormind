CREATE CONSTRAINT process_id IF NOT EXISTS FOR (n:Process) REQUIRE n.process_id IS UNIQUE;
CREATE CONSTRAINT step_id IF NOT EXISTS FOR (n:Step) REQUIRE n.profile_id IS UNIQUE;
CREATE CONSTRAINT exception_id IF NOT EXISTS FOR (n:Exception) REQUIRE n.exception_id IS UNIQUE;
CREATE CONSTRAINT part_number IF NOT EXISTS FOR (n:Part) REQUIRE n.part_number IS UNIQUE;
CREATE CONSTRAINT equipment_id IF NOT EXISTS FOR (n:Equipment) REQUIRE n.equipment_id IS UNIQUE;
CREATE CONSTRAINT expert_id IF NOT EXISTS FOR (n:Expert) REQUIRE n.expert_id IS UNIQUE;
CREATE CONSTRAINT document_id IF NOT EXISTS FOR (n:Document) REQUIRE n.doc_id IS UNIQUE;
CREATE CONSTRAINT segment_id IF NOT EXISTS FOR (n:VideoSegment) REQUIRE n.segment_id IS UNIQUE;
CREATE CONSTRAINT symptom_id IF NOT EXISTS FOR (n:Symptom) REQUIRE n.symptom_id IS UNIQUE;
CREATE CONSTRAINT cause_id IF NOT EXISTS FOR (n:RootCause) REQUIRE n.cause_id IS UNIQUE;
CREATE CONSTRAINT lot_id IF NOT EXISTS FOR (n:Lot) REQUIRE n.lot_id IS UNIQUE;
CREATE FULLTEXT INDEX symptom_name IF NOT EXISTS FOR (n:Symptom) ON EACH [n.name];
