# Copy to .env and edit (spec 01 §4). .env is THE config file: KNOWHOW_* settings, the vendor
# API keys and the Compose variables all live here. It is gitignored; never commit it.
# How to obtain each vendor's key: .secrets/README.md (that folder is documentation only).
KNOWHOW_NEO4J_URI=bolt://localhost:7687
KNOWHOW_NEO4J_USER=neo4j
KNOWHOW_NEO4J_PASSWORD=change-me
KNOWHOW_VECTOR_BACKEND=pgvector        # pgvector | memory
KNOWHOW_PG_DSN=postgresql://knowhow:change-me@localhost:5432/knowhow
KNOWHOW_VECTOR_TABLE=knowhow_chunks
KNOWHOW_EMBED_DIM=1024                 # bge-m3 dense
KNOWHOW_EMBED_MODEL=BAAI/bge-m3
# spec 02 ingest: Docling is the extractor; mmore is the degraded PDF fallback (install it separately)
KNOWHOW_MMORE_BIN=mmore
KNOWHOW_TOKEN_COUNTER=bge-m3          # bge-m3 | whitespace (offline; undercounts Japanese/Vietnamese)

# VLM (spec 04). `uv run knowhow vlm providers` lists every provider and whether its key is set.
KNOWHOW_VLM_PROVIDER=local_openai      # local_openai | openrouter | siliconflow | qwen_api | openai_compatible | fake
# Empty = the provider's default: local_openai = Ollama at http://127.0.0.1:11434/v1, model
# qwen3-vl:8b (Q4). Inside the mentormind container use http://vlm-server:11434/v1 (compose sets it).
# (Keep comments off empty values: dotenv would read them as the value.)
# Another machine's Ollama through ngrok (it runs `bash 3rdparty/vlm_server/scripts/serve-ollama.sh
# --ngrok`, which prints the URL): https://user:password@<name>.ngrok-free.dev/v1 — basic auth in the
# URL, never shown in error messages. A public host counts as cloud: DataGuard blocks factory data,
# faces are blurred, `eval ragas` needs --classification public.
KNOWHOW_VLM_BASE_URL=
KNOWHOW_VLM_MODEL=qwen3-vl:8b
KNOWHOW_VLM_FPS=4
# A 10 s segment at 4 fps has at most 40 frames (512 tokens each on Ollama, ~22k per request).
KNOWHOW_VLM_MAX_FRAMES=40
# The Ollama Q4 model thinks (~8k tokens) before answering; a 16 GB Mac through ngrok takes minutes
# per call. Long timeouts cost nothing on a fast server.
KNOWHOW_VLM_TIMEOUT_S=1800
KNOWHOW_VLM_MAX_RETRIES=3
KNOWHOW_VLM_JSON_MODE=auto             # auto | json_schema | json_object | off
KNOWHOW_VLM_MAX_TOKENS=16384
KNOWHOW_VLM_EXTRA_BODY={"presence_penalty": 1.5}   # stops Qwen3-VL looping long step lists
# Step times in a segment (spec 04 §3): segment = steps tile the segment in start order (each until
# the next starts); model = the VLM's own ~1 s spans. Default segment: closer to hand labels on LASI.
KNOWHOW_VLM_STEP_TIMES=segment         # segment | model
# VLM/LLM requests one video job keeps in flight (spec 04 §3): passes A and B together, then the reason
# proposals. 1 = one at a time. vLLM batches them (a Thinking job several times shorter: 4 on a 24 GB
# card); Ollama answers one request at a time, keep 1. 1 to 16.
KNOWHOW_VLM_CONCURRENCY=1

# Team inference server (spec 02 FR-02c/FR-07d, spec 03 FR-07c; repo mentormind-inference): the heavy
# CPU models — Whisper, Docling/OCR, bge-m3 — on the team's own machine instead of this one, each
# switched on below (= remote). Base URL of its API, usually the same server as KNOWHOW_VLM_BASE_URL,
# e.g. http://gpu-box:8000/v1 or https://<name>.ngrok-free.dev/v1 (basic auth in the URL is never shown
# in errors). Local or cloud like the VLM: a private address or a host listed in KNOWHOW_LOCAL_HOSTS
# is local; any other public host is cloud and DataGuard refuses to send it factory_confidential
# audio, documents or text (search questions count as factory_confidential).
KNOWHOW_INFERENCE_URL=
# Bearer token. Empty = KNOWHOW_VLM_API_KEY, but only when KNOWHOW_VLM_BASE_URL is on the same host
# (a key forced for a cloud vendor never goes to another server); otherwise no header.
KNOWHOW_INFERENCE_API_KEY=
# Whisper on a CPU takes minutes for a 30-minute recording.
KNOWHOW_INFERENCE_TIMEOUT_S=1800
KNOWHOW_INFERENCE_MAX_RETRIES=2
# Speech-to-text (spec 03 FR-07c): faster_whisper = here | remote = Whisper on the inference server
# (KNOWHOW_ASR_MODEL empty = the server's default). Settings of the local model: see "Speech-to-text" below.
KNOWHOW_ASR_PROVIDER=faster_whisper
# Embeddings: bge-m3 = here (ingest extra) | remote = the same bge-m3 on the inference server (same
# vectors: one table serves both) | hashing = stand-in with no semantics, dev only.
KNOWHOW_EMBEDDER=bge-m3
# Document extraction (spec 02): docling = here (ingest extra) | remote = Docling/OCR on the inference
# server (same chunks). mmore stays the degraded PDF fallback either way.
KNOWHOW_DOC_EXTRACTOR=docling
# Hostnames that are the team's own server even though public (e.g. an ngrok tunnel): calls to them
# count as local (VLM and inference), so no blocking/blurring. JSON list, whole names: ["<name>.ngrok-free.dev"].
KNOWHOW_LOCAL_HOSTS=[]

# Video cutting (spec 03 FR-03) when the UI/CLI names no method: hand_activity | scene | fixed_window.
# hand_activity suits one operator filmed continuously; edited videos with shot changes (LASI): scene.
KNOWHOW_VIDEO_METHOD=hand_activity

# Speech-to-text (spec 03 FR-07c). Never a third-party API; `uv run knowhow video providers` lists them.
# faster_whisper: here; first use downloads the model (small: ~480 MB) into the Hugging Face cache.
KNOWHOW_ASR_MODEL=small
KNOWHOW_ASR_DEVICE=cpu
KNOWHOW_ASR_COMPUTE_TYPE=int8
# Empty = detected per file (Vietnamese, Thai... the expert's own language); set e.g. vi to force one.
KNOWHOW_ASR_LANGUAGE=
KNOWHOW_ASR_BEAM_SIZE=5

# LLM (spec 06; also spec 04 pass C). Same provider names as the VLM; same keys below.
# Empty provider = the LLM is the VLM: same provider, server, model and key as KNOWHOW_VLM_*.
# Set one (qwen_api | local_openai | openrouter | siliconflow | openai_compatible | fake) to use
# another LLM; then empty model = its default (qwen_api: qwen-plus; local_openai: Ollama qwen3-vl:8b).
KNOWHOW_LLM_PROVIDER=
KNOWHOW_LLM_BASE_URL=
KNOWHOW_LLM_MODEL=
KNOWHOW_LLM_MAX_TOKENS=8192
KNOWHOW_LLM_TIMEOUT_S=1800
# Agents (spec 06). Work Assistant guards: 1) spec 05 RRF score floor (rank based, ~0.133 max,
# so it only stops "nothing found"); 2) bge-m3 cosine question/passage, below = refuse without the LLM.
KNOWHOW_ASSIST_MIN_SCORE=0.02
KNOWHOW_ASSIST_MIN_COSINE=0.40
# Traces of every agent call.
KNOWHOW_TRACE_DIR=data/work/traces
# REST API agents: mock = demo answers of the routers, live = Work Assistant / RCA Agent
# (needs Neo4j + vector store + LLM up).
KNOWHOW_API_AGENTS=mock
# Evaluation (spec 09). Who computes the four Ragas metrics: ragas = the ragas package
# (uv sync --extra eval), builtin = the project's own prompts, same definitions, no ragas needed.
# builtin for the Ollama demo: on the LASI run it computed 9 of 12 values, ragas 2 of 12.
KNOWHOW_EVAL_JUDGE=builtin
# ragas judge only: parallel calls and seconds per ragas job (empty = the judge LLM's
# KNOWHOW_LLM_TIMEOUT_S). Ollama answers one request at a time: 1 (vLLM: its max_num_seqs, e.g. 4).
KNOWHOW_EVAL_MAX_WORKERS=1
# KNOWHOW_EVAL_TIMEOUT_S=900
# Judge LLM of the Ragas metrics; empty = the agent's KNOWHOW_LLM_*.
KNOWHOW_EVAL_LLM_PROVIDER=
KNOWHOW_EVAL_LLM_BASE_URL=
KNOWHOW_EVAL_LLM_MODEL=

# REST API (spec 08): `uvicorn mentormind.backend.app.main:app`. CORS = the UI's origin only.
KNOWHOW_APP_NAME=MentorMind Know-How API
KNOWHOW_CORS_ORIGINS=["http://localhost:5173"]

KNOWHOW_PROFILE_DB=data/work/profiles.sqlite
# auto = profile store of spec 08 when present, else data/work/vlm/<video_id>/profiles.json
KNOWHOW_PROFILE_SINK=auto
KNOWHOW_SIGMA_ADAPTER=csv
KNOWHOW_SIGMA_CSV_DIR=data/mock_sigma


# --- API keys (spec 01 FR-09). Cloud keys are only for public/synthetic data: DataGuard blocks
# factory_confidential from ever reaching a cloud provider. How to get each key: .secrets/README.md
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
# Alibaba Singapore: the workspace host shown next to the key, as a full base URL
#   https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Optional bearer token for a self-hosted server behind an auth proxy (Ollama itself has none).
VLM_SERVER_API_KEY=
# Optional: force one key for whichever provider is selected (beats the vendor names above).
# KNOWHOW_VLM_API_KEY=
# KNOWHOW_LLM_API_KEY=

# --- VLM server: Ollama + Qwen3-VL-8B Q4_K_M (mentormind-inference, 3rdparty/vlm_server) ---------------
# Read by the vlm-server container and by `bash 3rdparty/vlm_server/scripts/serve-ollama.sh`.
VLM_SERVER_OLLAMA_MODEL=qwen3-vl:8b
# Prompt + answer budget per request (Ollama's own default is 4096: far too small for frames).
# Empty = 98304 (Docker, Linux) or 49152 on macOS, whose RAM is shared with the GPU.
VLM_SERVER_CONTEXT_LENGTH=
# Tokens one image costs at least. Ollama alone forces 1024 for Qwen-VL (a 448x252 frame is 112
# tokens at its own size, so it is upscaled ~9x); mentormind-inference's wrapper makes it configurable.
# 512 matched the BF16 vLLM quality on the LASI sweep (2026-10-04) with 29% fewer tokens than 1024.
VLM_SERVER_IMAGE_MIN_TOKENS=512
# The ONE GPU (or MI250 GCD) given to vlm-server.
VLM_GPU=0
VLM_SERVER_PORT=11434

# --- Docker Compose (docker-compose.yml + infra/docker/*.yml; spec 01 FR-05, task D3) ---
# Rootful Docker: files the container creates in the bind-mounted repo stay yours.
DEV_UID=1000
DEV_GID=1000
# AMD only (infra/docker/docker-compose.rocm.yml). HOST GIDs of /dev/kfd and /dev/dri/renderD*:
#   getent group video render
DRI_VIDEO_GID=44
DRI_RENDER_GID=109
KNOWHOW_PG_PASSWORD=change-me
KNOWHOW_PG_PORT=5432
KNOWHOW_NEO4J_HTTP_PORT=7474
KNOWHOW_NEO4J_BOLT_PORT=7687
